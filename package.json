{
  "name": "appskyline",
  "version": "1.5.0",
  "private": false,
  "description": "App Store Optimization CLI — app rankings, keyword research, and store-listing metadata across the iOS App Store, macOS App Store, Google Play, and Microsoft Store",
  "license": "Apache-2.0",
  "repository": "github:appskyline/cli",
  "homepage": "https://www.appskyline.com/developers/",
  "author": "Appskyline",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "bin": {
    "appskyline": "./bin/appskyline.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "develop": "node index.js",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "publish:repo": "node scripts/publishCli.mjs",
    "test:smoke": "npm run build && node scripts/smoke.js"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "keywords": [
    "aso",
    "app-store-optimization",
    "app-store",
    "google-play",
    "microsoft-store",
    "rankings",
    "keyword-research",
    "cli"
  ],
  "dependencies": {
    "commander": "8.3.0",
    "fs-extra": "10.1.0",
    "inquirer": "8.2.5",
    "node-localstorage": "2.2.1"
  },
  "devDependencies": {
    "@monorepool/agentfirst": "0.0.0",
    "@monorepool/root": "0.0.0",
    "esbuild": "0.25.4",
    "vitest": "catalog:"
  }
}
