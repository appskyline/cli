  "repository": "github:appskyline/cli",
  "homepage": "https://www.appskyline.com/developers/",
  "author": "Appskyline",
  "type": "commonjs",
  "main": "./dist/index.js",
  "bin": {
    "appskyline": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
